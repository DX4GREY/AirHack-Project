<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_ap"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_scanner_item"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ssidTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ssid_def"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/signalTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:typeface="monospace"
            android:textSize="13sp"
            android:text="@string/signal_strength_def" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/bssidTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:typeface="monospace"
            android:textSize="12sp"
            android:text="@string/bssid_def" />

        <TextView
            android:id="@+id/frequencyTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:typeface="monospace"
            android:textSize="12sp"
            android:text="@string/frequency_def" />
    </LinearLayout>
</LinearLayout>
